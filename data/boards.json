{
  "schema_version": "1.0",
  "description": "Leaderboard mounts on xpolicylab.github.io. RoboTwin fetches RoboTwin-published JSON; both RoboDojo boards fetch the official robodojo-benchmark.com JSON and fall back to the bundled Sim snapshot or the RoboTwin Real mirror if it is unavailable.",
  "index_url": "https://robotwin-platform.github.io/data/index.json",
  "boards": [
    {
      "id": "robotwin",
      "kind": "robotwin",
      "name": "RoboTwin 2.0 Leaderboard",
      "mount": "[data-xpl-lb=robotwin]",
      "data_url": "https://robotwin-platform.github.io/data/robotwin_leaderboard.json",
      "page_url": "https://robotwin-platform.github.io/leaderboard",
      "preview_top_n": 10
    },
    {
      "id": "robodojo",
      "kind": "robodojo",
      "name": "RoboDojo Sim Leaderboard",
      "mount": "[data-xpl-lb=robodojo]",
      "data_url": "https://robodojo-benchmark.com/data/leaderboard.generated.json",
      "section": "sim",
      "snapshot": "js/leaderboard/robodojo_sim.js",
      "page_url": "https://robodojo-benchmark.com/leaderboard",
      "note": "The snapshot (2026-09-28, 51 models) is used only when the live JSON cannot be fetched.",
      "preview_top_n": 10
    },
    {
      "id": "robodojo-real",
      "kind": "robodojo",
      "name": "RoboDojo Real Leaderboard",
      "mount": "[data-xpl-lb=robodojo-real]",
      "data_url": "https://robodojo-benchmark.com/data/leaderboard.generated.json",
      "section": "realworld",
      "fallback_url": "https://robotwin-platform.github.io/data/robodojo_real_leaderboard.json",
      "page_url": "https://robodojo-benchmark.com/leaderboard",
      "preview_top_n": 10
    }
  ]
}
